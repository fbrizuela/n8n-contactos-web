{
  "id": "bICpO83fpvwZIAcu",
  "name": "Contactos web: validar, guardar en Sheets y avisar",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "contacto",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1",
      "name": "Formulario web",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "contacto-fbrizuela"
    },
    {
      "parameters": {
        "jsCode": "// Normaliza y valida lo que manda el formulario\nconst b = $input.first().json.body || {};\nconst nombre = String(b.nombre || '').trim();\nconst email = String(b.email || '').trim().toLowerCase();\nconst telefono = String(b.telefono || '').replace(/[^\\d+]/g, '');\nconst mensaje = String(b.mensaje || '').trim();\n\nconst errores = [];\nif (nombre.length < 2) errores.push('Falta el nombre');\nif (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email) && telefono.length < 8) errores.push('Falta un email o teléfono válido');\nif (mensaje.length < 5) errores.push('El mensaje está vacío');\n\n// Clasificación simple por palabras clave\nconst t = mensaje.toLowerCase();\nlet tipo = 'Consulta general';\nif (/(presupuesto|precio|cu[aá]nto (sale|cuesta)|cotiz|hacen p[aá]ginas|tarifa)/.test(t)) tipo = 'Presupuesto';\nelse if (/(no (anda|prende|funciona|imprime|carga|enciende)|rot[oa]|romp|falla|error|arregl|repar)/.test(t)) tipo = 'Reparación';\nelse if (/(trabajo|puesto|entrevista|cv|búsqueda|busqueda)/.test(t)) tipo = 'Laboral';\nconst urgente = /(urgente|hoy|ya mismo|lo antes posible)/.test(t);\n\nreturn [{ json: {\n  valido: errores.length === 0,\n  errores,\n  fecha: new Date().toLocaleString('es-AR', { timeZone: 'America/Argentina/Buenos_Aires', hour12: false, dateStyle: 'short', timeStyle: 'short' }),\n  nombre, email, telefono, mensaje, tipo,\n  prioridad: urgente ? 'Alta' : 'Normal'\n} }];"
      },
      "id": "a2",
      "name": "Validar y clasificar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.valido }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a3",
      "name": "¿Es válido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://ntfy.sh/{{ $env.NTFY_TOPIC }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "title",
              "value": "={{ 'Nuevo contacto: ' + $('Validar y clasificar').item.json.tipo }}"
            },
            {
              "name": "priority",
              "value": "={{ $('Validar y clasificar').item.json.prioridad === 'Alta' ? 'high' : 'default' }}"
            },
            {
              "name": "tags",
              "value": "={{ $('Validar y clasificar').item.json.prioridad === 'Alta' ? 'rotating_light' : 'envelope' }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "text/plain",
        "body": "={{ $('Validar y clasificar').item.json.nombre }} ({{ $('Validar y clasificar').item.json.email || $('Validar y clasificar').item.json.telefono }})\n{{ $('Validar y clasificar').item.json.mensaje }}",
        "options": {}
      },
      "id": "a4",
      "name": "Aviso al celular (ntfy)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        200
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true, tipo: $('Validar y clasificar').item.json.tipo } }}",
        "options": {}
      },
